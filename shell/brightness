#!/usr/bin/env bash
set -euo pipefail

STEP="5%"
TAG="brightness"

usage() {
  echo "Usage: ${0##*/} <up|down>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

case "$1" in
  up)   brightnessctl set "${STEP}+" >/dev/null ;;
  down) brightnessctl set "${STEP}-" >/dev/null ;;
  *)    usage ;;
esac

percent=$(brightnessctl -m | cut -d, -f4 | tr -d '%')

notify-send -a brightness -u low \
  -h "string:x-dunst-stack-tag:$TAG" \
  -h "int:value:$percent" \
  "Brightness" "${percent}%"
