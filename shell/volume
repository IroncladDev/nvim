#!/usr/bin/env bash
set -euo pipefail

SINK="@DEFAULT_AUDIO_SINK@"
STEP="5%"
TAG="volume"

usage() {
  echo "Usage: ${0##*/} <up|down>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

case "$1" in
  up)   wpctl set-volume -l 1.0 "$SINK" "${STEP}+" ;;
  down) wpctl set-volume "$SINK" "${STEP}-" ;;
  *)    usage ;;
esac

read -r _ vol muted < <(wpctl get-volume "$SINK")
percent=$(awk -v v="$vol" 'BEGIN { printf "%d", v * 100 + 0.5 }')

if [[ "${muted:-}" == "[MUTED]" ]]; then
  notify-send -a volume -u low \
    -h "string:x-dunst-stack-tag:$TAG" \
    -h "int:value:0" \
    "Volume" "Muted"
else
  notify-send -a volume -u low \
    -h "string:x-dunst-stack-tag:$TAG" \
    -h "int:value:$percent" \
    "Volume" "${percent}%"
fi
